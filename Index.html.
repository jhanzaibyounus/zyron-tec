<script>
  // ============================================================
  // ⚙️  CONFIG — sirf yahan change karein
  // ============================================================
  const CONFIG = {
    shopName:     "Zyron Mobile Accessories",
    address:      "Korangi, Karachi, Pakistan",
    phone:        "+92 317 2104346",
    phoneRaw:     "923172104346",
    email:        "info@zyronmobile.pk",
    hours:        "Mon - Sat: 10 AM - 10 PM",
    easypaisa:    "0317 2104346",
    easypaisaRaw: "03172104346"
  };

  const FREE_SHIPPING_MIN = 1500;
  const SHIPPING_FEE = 150;

  const FALLBACK_IMG = "data:image/svg+xml;utf8," + encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" width="400" height="200">' +
    '<rect width="100%" height="100%" fill="#131836"/>' +
    '<text x="50%" y="50%" fill="#00d4ff" font-family="sans-serif" font-size="30" ' +
    'text-anchor="middle" dominant-baseline="middle">Zyron</text></svg>'
  );

  // ===== HELPERS =====
  const esc = s => String(s).replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const money = n => 'Rs. ' + Number(n).toLocaleString('en-PK');

  // ============================================================
  // 📦 PRODUCTS — Sirf Chargers aur Data Cables
  // ============================================================
  const products = [
    // ========== CHARGERS ==========
    { id: 1,  name: "Fast Charger 20W USB-C (Android)",   price: 1299, old: 1799, cat: "Chargers", img: "https://images.unsplash.com/photo-1583863788434-e58a36330cf0?w=400", tag: "HOT",  rating: 4.9 },
    { id: 2,  name: "iPhone 20W USB-C Adapter",           price: 1499, old: 1999, cat: "Chargers", img: "https://images.unsplash.com/photo-1591290619762-c61ee1eb1c3d?w=400", tag: "HOT",  rating: 4.8 },
    { id: 3,  name: "65W GaN Fast Charger (Type-C)",      price: 2899, old: 3999, cat: "Chargers", img: "https://images.unsplash.com/photo-1591290619762-3c9a5c15ed4d?w=400", tag: "NEW",  rating: 4.8 },
    { id: 4,  name: "33W Fast Charger (Android)",         price: 1699, old: 2299, cat: "Chargers", img: "https://images.unsplash.com/photo-1609592806596-b43bada2f2d7?w=400", tag: "",     rating: 4.6 },
    { id: 5,  name: "Wireless Charging Pad 15W",          price: 1599, old: 2299, cat: "Chargers", img: "https://images.unsplash.com/photo-1586953208448-b95a79798f07?w=400", tag: "NEW",  rating: 4.5 },
    { id: 6,  name: "Car Charger Dual USB 3.4A",          price: 799,  old: 1199, cat: "Chargers", img: "https://images.unsplash.com/photo-1615838752138-61e3a26a9c2a?w=400", tag: "SALE", rating: 4.4 },
    { id: 7,  name: "Multi-Port Charger 4 USB",           price: 1899, old: 2599, cat: "Chargers", img: "https://images.unsplash.com/photo-1615526675159-e248c3021d3f?w=400", tag: "HOT",  rating: 4.7 },
    { id: 8,  name: "Original Samsung 25W Charger",       price: 1999, old: 2799, cat: "Chargers", img: "https://images.unsplash.com/photo-1588347818036-0e16cfdad1e6?w=400", tag: "",     rating: 4.8 },

    // ========== DATA CABLES ==========
    { id: 9,  name: "Type-C Data Cable 1m (Android)",     price: 349,  old: 549,  cat: "Cables",   img: "https://images.unsplash.com/photo-1588347818036-0e16cfdad1e6?w=400", tag: "SALE", rating: 4.6 },
    { id: 10, name: "Type-C Braided Cable 2m",            price: 499,  old: 799,  cat: "Cables",   img: "https://images.unsplash.com/photo-1601524909162-ae8725290836?w=400", tag: "HOT",  rating: 4.7 },
    { id: 11, name: "iPhone Lightning Cable 1m",          price: 599,  old: 899,  cat: "Cables",   img: "https://images.unsplash.com/photo-1610438154856-2b03be9a4a5e?w=400", tag: "HOT",  rating: 4.8 },
    { id: 12, name: "iPhone Lightning Cable 2m",          price: 799,  old: 1199, cat: "Cables",   img: "https://images.unsplash.com/photo-1585060544812-6b45742d762f?w=400", tag: "",     rating: 4.7 },
    { id: 13, name: "Micro-USB Data Cable 1m",            price: 249,  old: 449,  cat: "Cables",   img: "https://images.unsplash.com/photo-1587574293340-e0011c4e8ecf?w=400", tag: "SALE", rating: 4.4 },
    { id: 14, name: "3-in-1 Fast Charging Cable",         price: 449,  old: 699,  cat: "Cables",   img: "https://images.unsplash.com/photo-1615526675159-e248c3021d3f?w=400", tag: "HOT",  rating: 4.7 },
    { id: 15, name: "USB-C to USB-C 60W Cable",           price: 699,  old: 1099, cat: "Cables",   img: "https://images.unsplash.com/photo-1625842268584-8f3296236761?w=400", tag: "NEW",  rating: 4.8 },
    { id: 16, name: "Nylon Braided Lightning Cable 1m",   price: 549,  old: 849,  cat: "Cables",   img: "https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?w=400", tag: "",     rating: 4.6 },
    { id: 17, name: "Type-C to Lightning Cable 1m",       price: 899,  old: 1299, cat: "Cables",   img: "https://images.unsplash.com/photo-1592286927505-1def25115558?w=400", tag: "NEW",  rating: 4.8 },
    { id: 18, name: "Retractable Type-C Cable",           price: 599,  old: 899,  cat: "Cables",   img: "https://images.unsplash.com/photo-1601524909162-ae8725290836?w=400", tag: "HOT",  rating: 4.5 }
  ];

  let activeCategory = 'All';

  // ===== STORAGE =====
  function loadCart() {
    try { return JSON.parse(localStorage.getItem('zyronCart')) || []; }
    catch { return []; }
  }
  function saveCart() {
    try { localStorage.setItem('zyronCart', JSON.stringify(cart)); } catch {}
  }
  function saveOrder(order) {
    try {
      const orders = JSON.parse(localStorage.getItem('zyronOrders')) || [];
      orders.push(order);
      localStorage.setItem('zyronOrders', JSON.stringify(orders));
    } catch {}
  }

  let cart = loadCart();

  // ===== TOTALS =====
  function getTotals() {
    const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
    const shipping = (subtotal === 0 || subtotal >= FREE_SHIPPING_MIN) ? 0 : SHIPPING_FEE;
    return { subtotal, shipping, total: subtotal + shipping };
  }

  // ===== RENDER CONTACT INFO =====
  function renderContactInfo() {
    document.getElementById('contactInfo').innerHTML = `
      <div class="info-box">
        <div class="icon">📍</div>
        <div><h4>Address</h4><p>${esc(CONFIG.address)}</p></div>
      </div>
      <div class="info-box">
        <div class="icon">📞</div>
        <div><h4>Phone / WhatsApp</h4>
          <p><a href="tel:+${esc(CONFIG.phoneRaw)}">${esc(CONFIG.phone)}</a></p>
        </div>
      </div>
      <div class="info-box">
        <div class="icon">✉️</div>
        <div><h4>Email</h4>
          <p><a href="mailto:${esc(CONFIG.email)}">${esc(CONFIG.email)}</a></p>
        </div>
      </div>
      <div class="info-box">
        <div class="icon">🕒</div>
        <div><h4>Working Hours</h4><p>${esc(CONFIG.hours)}</p></div>
      </div>`;

    document.getElementById('whatsappLink').href =
      `https://wa.me/${CONFIG.phoneRaw}?text=` +
      encodeURIComponent('Assalam-o-Alaikum! Mujhe Zyron Mobile se order karna hai.');
  }

  // ===== RENDER CATEGORIES =====
  function renderCategories() {
    const cats = ['All', ...new Set(products.map(p => p.cat))];
    document.getElementById('categories').innerHTML = cats.map(c => `
      <button class="cat-btn ${c === activeCategory ? 'active' : ''}"
              type="button" onclick="filterCategory('${esc(c)}')">${esc(c)}</button>
    `).join('');
  }

  // ===== FILTER =====
  function filterCategory(cat) {
    activeCategory = cat;
    renderCategories();
    renderProducts();
    const el = document.getElementById('products');
    if (el) window.scrollTo({ top: el.offsetTop - 80, behavior: 'smooth' });
  }

  // ===== RENDER PRODUCTS =====
  function renderProducts() {
    const list = activeCategory === 'All'
      ? products
      : products.filter(p => p.cat === activeCategory);

    if (list.length === 0) {
      document.getElementById('productList').innerHTML =
        '<p style="grid-column:1/-1;text-align:center;color:var(--muted);padding:40px;">Koi product nahi mila.</p>';
      return;
    }

    document.getElementById('productList').innerHTML = list.map(p => {
      const tagClass = p.tag ? p.tag.toLowerCase() : '';
      const discount = p.old > p.price
        ? `<small>${money(p.old)}</small>`
        : '';
      return `
        <div class="product-card">
          ${p.tag ? `<span class="tag ${tagClass}">${esc(p.tag)}</span>` : ''}
          <span class="cat-label">${esc(p.cat)}</span>
          <img src="${esc(p.img)}" alt="${esc(p.name)}" width="400" height="200"
               loading="lazy" onerror="this.onerror=null;this.src=FALLBACK_IMG">
          <h3>${esc(p.name)}</h3>
          <div class="rating">⭐ ${esc(p.rating)}</div>
          <div class="price">${money(p.price)} ${discount}</div>
          <button class="btn btn-primary" type="button" onclick="addToCart(${p.id})">Add to Cart</button>
        </div>
      `;
    }).join('');
  }

  // ===== CART =====
  function addToCart(id) {
    const product = products.find(p => p.id === id);
    if (!product) return;
    const existing = cart.find(item => item.id === id);
    if (existing) existing.qty++;
    else cart.push({ id: product.id, name: product.name, price: product.price, qty: 1 });
    saveCart();
    updateCartCount();
    showToast(`✅ ${product.name} added to cart!`);
  }

  function updateCartCount() {
    const count = cart.reduce((sum, i) => sum + i.qty, 0);
    const el = document.getElementById('cartCount');
    el.textContent = count;
    el.hidden = count === 0;
  }

  function renderCart() {
    const container = document.getElementById('cartItems');
    const totalEl = document.getElementById('cartTotal');

    if (cart.length === 0) {
      container.innerHTML = '<div class="empty-cart">🛒 Aapka cart khali hai<br><br>Products add karein shopping start karne ke liye</div>';
      totalEl.textContent = '';
      return;
    }

    container.innerHTML = cart.map(item => `
      <div class="cart-item">
        <div class="cart-item-info">
          <strong>${esc(item.name)}</strong>
          <span>${money(item.price)} × ${item.qty} = ${money(item.price * item.qty)}</span>
        </div>
        <div style="display:flex; align-items:center; gap:10px;">
          <input type="number" min="1" value="${item.qty}"
                 onchange="updateQty(${item.id}, this.value)" aria-label="Quantity for ${esc(item.name)}">
          <button class="close-x" type="button" style="position:static; font-size:18px;"
                  aria-label="Remove ${esc(item.name)}" onclick="removeItem(${item.id})">🗑️</button>
        </div>
      </div>
    `).join('');

    const { subtotal, shipping, total } = getTotals();
    totalEl.innerHTML =
      `<div>Subtotal: ${money(subtotal)}</div>` +
      (shipping
        ? `<div>Shipping: ${money(shipping)}</div>`
        : `<div style="color:var(--success)">Shipping: Free ✓</div>`) +
      `<div class="grand">Total: ${money(total)}</div>`;
  }

  function updateQty(id, qty) {
    const item = cart.find(i => i.id === id);
    if (item) {
      item.qty = Math.max(1, parseInt(qty, 10) || 1);
      saveCart(); renderCart(); updateCartCount();
    }
  }

  function removeItem(id) {
    cart = cart.filter(i => i.id !== id);
    saveCart(); renderCart(); updateCartCount();
  }

  // ===== MODALS =====
  let lastFocused = null;

  function openModal(id) {
    if (id === 'cartModal') renderCart();
    const m = document.getElementById(id);
    lastFocused = document.activeElement;
    m.classList.add('active');
    document.body.classList.add('modal-open');
    const focusable = m.querySelector('button, input, textarea, a[href]');
    if (focusable) setTimeout(() => focusable.focus(), 30);
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
    if (!document.querySelector('.modal.active')) document.body.classList.remove('modal-open');
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal.active').forEach(m => closeModal(m.id));
      return;
    }
    if (e.key === 'Tab') {
      const modal = document.querySelector('.modal.active');
      if (!modal) return;
      const nodes = modal.querySelectorAll('button, input, textarea, a[href], select');
      const list = Array.from(nodes).filter(el => !el.disabled && el.offsetParent !== null);
      if (!list.length) return;
      const first = list[0], last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  document.querySelectorAll('.modal').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) closeModal(m.id); });
  });

  function openCheckout() {
    if (cart.length === 0) { showToast('❌ Cart khali hai!'); return; }
    const { subtotal, shipping, total } = getTotals();
    document.getElementById('checkoutSummary').innerHTML =
      cart.map(i => `<div class="row"><span>${esc(i.name)} × ${i.qty}</span><span>${money(i.price * i.qty)}</span></div>`).join('') +
      '<hr>' +
      `<div class="row"><span>Subtotal</span><span>${money(subtotal)}</span></div>` +
      `<div class="row"><span>Shipping</span><span>${shipping ? money(shipping) : 'Free'}</span></div>` +
      `<div class="row grand"><span>Total</span><span>${money(total)}</span></div>`;
    closeModal('cartModal');
    openModal('checkoutModal');
  }

  // ===== ORDER =====
  function processPayment(e) {
    e.preventDefault();
    const method = document.querySelector('input[name="pay"]:checked').value;
    const totals = getTotals();

    const order = {
      id: 'ZYN-' + Date.now().toString(36).toUpperCase(),
      items: cart.map(({ id, name, price, qty }) => ({ id, name, price, qty })),
      subtotal: totals.subtotal,
      shipping: totals.shipping,
      total: totals.total,
      customer: {
        name: document.getElementById('custName').value.trim(),
        email: document.getElementById('custEmail').value.trim(),
        phone: document.getElementById('custPhone').value.trim(),
        address: document.getElementById('custAddress').value.trim()
      },
      method,
      status: method === 'cod' ? 'pending' : 'awaiting-payment',
      createdAt: new Date().toISOString()
    };

    console.log('Order placed:', order);
    saveOrder(order);
    completeOrder(order);
  }

  function completeOrder(order) {
    cart = [];
    saveCart();
    updateCartCount();
    closeModal('checkoutModal');
    document.querySelector('.checkout-form').reset();

    const payNote = order.method === 'cod'
      ? '<p>💵 Cash on Delivery — delivery ke waqt payment karein.</p>'
      : `<p>📲 Payment bhejein aur screenshot WhatsApp karein:</p>
         <div class="pay-box">Easypaisa: ${esc(CONFIG.easypaisa)}</div>
         <a href="https://wa.me/${CONFIG.phoneRaw}" target="_blank" rel="noopener"
            class="btn btn-primary" style="width:100%;margin-top:8px;">
           💬 WhatsApp par screenshot bhejein
         </a>`;

    document.getElementById('confirmBody').innerHTML =
      `<h2 id="confirmTitle" style="margin-bottom:10px;">✅ Order Confirmed!</h2>
       <p>Shukriya ${esc(order.customer.name.split(' ')[0] || 'customer')}! Aapka order mil gaya hai.</p>
       <div class="big-id">${esc(order.id)}</div>
       <p style="color:var(--text);font-weight:700;font-size:18px;">${money(order.total)}</p>
       ${payNote}
       <p style="margin-top:14px;font-size:13px;">Order ID save kar lein — tracking ke liye zaroori hai.</p>
       <button class="btn btn-primary" type="button" style="width:100%;margin-top:16px;"
               onclick="closeModal('confirmModal')">Continue Shopping</button>`;

    openModal('confirmModal');
  }

  // ===== NAV / FORMS =====
  function toggleMenu(btn) {
    const nav = document.getElementById('nav');
    const open = nav.classList.toggle('active');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function sendContact(e) {
    e.preventDefault();
    showToast('✅ Message sent! Hum jaldi contact karenge.');
    e.target.reset();
  }

  function subscribeNews(e) {
    e.preventDefault();
    showToast('✅ Subscribed! Thanks for joining.');
    e.target.reset();
  }

  // ===== TOAST =====
  function showToast(msg) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
  }

  // ===== INIT =====
  renderContactInfo();
  renderCategories();
  renderProducts();
  updateCartCount();

  document.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => {
    document.getElementById('nav').classList.remove('active');
    document.querySelector('.menu-btn').setAttribute('aria-expanded', 'false');
  }));
</script>

</body>
