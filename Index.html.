<!-- CHECKOUT MODAL -->
<div class="modal" id="checkoutModal" role="dialog" aria-modal="true" aria-labelledby="checkoutTitle">
  <div class="modal-content">
    <button class="close-x" type="button" aria-label="Close checkout" onclick="closeModal('checkoutModal')">✕</button>
    <h2 id="checkoutTitle">💳 Checkout</h2>
    <div class="order-summary" id="checkoutSummary"></div>
    <form class="checkout-form" onsubmit="processPayment(event)">
