<!DOCTYPE html
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Zyron Mobile Accessories - Original chargers & data cables. Fast delivery across Pakistan." />
<meta name="theme-color" content="#0a0e27" />
<title>Zyron Mobile Accessories | Chargers & Cables</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }
  :root {
    --primary: #00d4ff;
    --secondary: #0077ff;
    --dark: #0a0e27;
    --dark-2: #131836;
    --text: #e6edff;
    --muted: #8892b0;
    --success: #10b981;
    --danger: #ef4444;
  }
  html { scroll-behavior: smooth; }
  body { background: var(--dark); color: var(--text); line-height: 1.6; overflow-x: hidden; }
  body.modal-open { overflow: hidden; }

  /* ===== TOP BAR ===== */
  .topbar {
    background: linear-gradient(90deg, var(--secondary), var(--primary));
    color: #000; text-align: center; padding: 8px; font-size: 14px; font-weight: 600;
  }

  /* ===== HEADER ===== */
  header {
    background: rgba(10, 14, 39, 0.95);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    padding: 15px 5%;
    display: flex; justify-content: space-between; align-items: center;
    position: sticky; top: 0; z-index: 1000;
    border-bottom: 1px solid rgba(0, 212, 255, 0.15);
  }
  .logo { font-size: 24px; font-weight: 800; color: var(--primary); letter-spacing: 1px; display: flex; align-items: center; gap: 8px; }
  .logo span { color: #fff; }
  nav { display: flex; gap: 30px; }
  nav a {
    color: var(--text); text-decoration: none; font-weight: 500; font-size: 15px;
    transition: 0.3s; position: relative;
  }
  nav a:hover { color: var(--primary); }
  nav a::after {
    content: ''; position: absolute; bottom: -5px; left: 0; width: 0; height: 2px;
    background: var(--primary); transition: 0.3s;
  }
  nav a:hover::after { width: 100%; }
  .header-right { display: flex; align-items: center; gap: 20px; }
  .cart-icon {
    position: relative; cursor: pointer; font-size: 22px; padding: 8px;
    background: var(--dark-2); border-radius: 10px; transition: 0.3s;
    border: none; color: var(--text); font-family: inherit; line-height: 1;
  }
  .cart-icon:hover { background: var(--primary); color: #000; }
  .cart-icon:focus-visible, .menu-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .cart-count {
    position: absolute; top: -5px; right: -5px; background: var(--danger);
    color: #fff; border-radius: 50%; padding: 2px 7px; font-size: 11px; font-weight: bold;
  }
  .menu-btn {
    display: none; font-size: 26px; cursor: pointer; color: var(--primary);
    background: none; border: none; font-family: inherit;
  }

  /* ===== HERO ===== */
  .hero {
    min-height: 80vh;
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 60px 5%;
    background: radial-gradient(circle at 50% 50%, rgba(0, 119, 255, 0.15), transparent 60%),
                linear-gradient(135deg, var(--dark), var(--dark-2));
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; width: 500px; height: 500px;
    background: radial-gradient(circle, var(--primary), transparent 70%);
    opacity: 0.15; top: -200px; right: -200px; border-radius: 50%;
  }
  .hero-content { max-width: 800px; z-index: 1; position: relative; }
  .badge {
    display: inline-block; padding: 6px 16px; background: rgba(0, 212, 255, 0.15);
    border: 1px solid var(--primary); color: var(--primary); border-radius: 50px;
    font-size: 13px; font-weight: 600; margin-bottom: 20px;
  }
  .hero h1 { font-size: 60px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; }
  .hero h1 span {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .hero p { font-size: 18px; color: var(--muted); margin-bottom: 35px; max-width: 600px; margin-left: auto; margin-right: auto; }
  .hero-btns { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }
  .btn {
    padding: 14px 32px; border: none; border-radius: 10px; font-weight: 700;
    cursor: pointer; font-size: 15px; transition: 0.3s; text-decoration: none;
    display: inline-block; text-align: center; font-family: inherit;
  }
  .btn-primary {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    color: #000; box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3);
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0, 212, 255, 0.5); }
  .btn-outline {
    background: transparent; color: var(--primary); border: 2px solid var(--primary);
  }
  .btn-outline:hover { background: var(--primary); color: #000; }

  /* ===== STATS ===== */
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px; padding: 60px 5%; background: var(--dark-2);
    border-top: 1px solid rgba(0, 212, 255, 0.1);
    border-bottom: 1px solid rgba(0, 212, 255, 0.1);
  }
  .stat-box { text-align: center; padding: 20px; }
  .stat-box h2 { font-size: 42px; color: var(--primary); font-weight: 800; }
  .stat-box p { color: var(--muted); font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }

  /* ===== SECTION ===== */
  section { padding: 80px 5%; }
  .section-title { text-align: center; margin-bottom: 50px; }
  .section-title h2 { font-size: 40px; font-weight: 800; margin-bottom: 10px; }
  .section-title h2 span { color: var(--primary); }
  .section-title p { color: var(--muted); font-size: 16px; }

  /* ===== CATEGORY FILTER ===== */
  .categories {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 10px;
    margin-bottom: 40px;
  }
  .cat-btn {
    padding: 10px 24px; background: var(--dark-2); color: var(--text);
    border: 1px solid rgba(0, 212, 255, 0.2); border-radius: 50px;
    cursor: pointer; font-size: 14px; font-weight: 600; font-family: inherit;
    transition: 0.3s;
  }
  .cat-btn:hover { border-color: var(--primary); color: var(--primary); }
  .cat-btn.active {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    color: #000; border-color: transparent;
  }

  /* ===== PRODUCTS ===== */
  .products-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 25px;
  }
  .product-card {
    background: var(--dark-2); border-radius: 16px; padding: 15px;
    text-align: center; transition: 0.3s; border: 1px solid rgba(0, 212, 255, 0.1);
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .product-card:hover {
    transform: translateY(-10px); border-color: var(--primary);
    box-shadow: 0 20px 40px rgba(0, 212, 255, 0.15);
  }
  .product-card .tag {
    position: absolute; top: 15px; left: 15px; background: var(--danger);
    color: #fff; padding: 4px 10px; border-radius: 5px; font-size: 11px; font-weight: bold;
    z-index: 1; letter-spacing: 0.5px;
  }
  .product-card .tag.hot { background: #ff6b35; }
  .product-card .tag.new { background: var(--success); }
  .product-card .tag.sale { background: var(--danger); }
  .product-card .cat-label {
    position: absolute; top: 15px; right: 15px; background: rgba(0, 212, 255, 0.15);
    color: var(--primary); padding: 3px 8px; border-radius: 5px; font-size: 10px;
    font-weight: 600; z-index: 1; text-transform: uppercase; letter-spacing: 0.5px;
  }
  .product-card img {
    width: 100%; height: 200px; object-fit: cover; border-radius: 12px;
    margin-bottom: 15px; background: var(--dark); display: block;
  }
  .product-card h3 { font-size: 16px; margin-bottom: 8px; font-weight: 600; min-height: 44px; }
  .product-card .rating { color: #ffc107; font-size: 13px; margin-bottom: 8px; }
  .product-card .price { font-size: 22px; color: var(--primary); font-weight: 800; margin-bottom: 12px; }
  .product-card .price small { color: var(--muted); text-decoration: line-through; font-size: 14px; margin-left: 8px; font-weight: 400; }
  .product-card .btn { width: 100%; padding: 12px; font-size: 14px; margin-top: auto; }

  /* ===== FEATURES ===== */
  .features-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 25px;
  }
  .feature-box {
    background: var(--dark-2); padding: 30px 20px; border-radius: 16px; text-align: center;
    border: 1px solid rgba(0, 212, 255, 0.1); transition: 0.3s;
  }
  .feature-box:hover { border-color: var(--primary); transform: translateY(-5px); }
  .feature-box .icon {
    font-size: 40px; margin-bottom: 15px; display: inline-block;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .feature-box h3 { margin-bottom: 10px; font-size: 18px; }
  .feature-box p { color: var(--muted); font-size: 14px; }

  /* ===== ABOUT ===== */
  .about-content {
    display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;
  }
  .about-text h2 { font-size: 36px; margin-bottom: 20px; }
  .about-text h2 span { color: var(--primary); }
  .about-text p { color: var(--muted); margin-bottom: 15px; }
  .about-text ul { list-style: none; margin-top: 20px; }
  .about-text ul li { padding: 8px 0; color: var(--text); }
  .about-text ul li::before { content: '✓ '; color: var(--success); font-weight: bold; margin-right: 8px; }
  .about-img {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    height: 400px; border-radius: 20px; display: flex; align-items: center; justify-content: center;
    font-size: 100px; box-shadow: 0 20px 60px rgba(0, 212, 255, 0.3);
  }

  /* ===== CONTACT ===== */
  .contact-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
  }
  .contact-info { display: flex; flex-direction: column; gap: 20px; }
  .info-box {
    display: flex; align-items: center; gap: 15px; background: var(--dark-2);
    padding: 20px; border-radius: 12px; border: 1px solid rgba(0, 212, 255, 0.1);
  }
  .info-box .icon { font-size: 28px; color: var(--primary); }
  .info-box h4 { font-size: 15px; margin-bottom: 3px; }
  .info-box p { color: var(--muted); font-size: 14px; }
  .info-box a { color: var(--muted); text-decoration: none; transition: 0.3s; }
  .info-box a:hover { color: var(--primary); }
  .contact-form {
    background: var(--dark-2); padding: 30px; border-radius: 16px;
    border: 1px solid rgba(0, 212, 255, 0.1);
  }
  .contact-form input, .contact-form textarea {
    width: 100%; padding: 14px; margin-bottom: 15px; border: 1px solid rgba(0, 212, 255, 0.2);
    border-radius: 10px; background: var(--dark); color: var(--text);
    font-family: inherit; font-size: 14px; outline: none; transition: 0.3s;
  }
  .contact-form input:focus, .contact-form textarea:focus { border-color: var(--primary); }
  .contact-form button { width: 100%; }

  /* ===== NEWSLETTER ===== */
  .newsletter {
    background: linear-gradient(90deg, var(--secondary), var(--primary));
    text-align: center; padding: 60px 5%; color: #000;
  }
  .newsletter h2 { font-size: 32px; margin-bottom: 10px; font-weight: 800; }
  .newsletter p { margin-bottom: 25px; font-weight: 500; }
  .newsletter form {
    max-width: 500px; margin: auto; display: flex; gap: 10px;
  }
  .newsletter input {
    flex: 1; padding: 14px; border: none; border-radius: 10px;
    font-size: 14px; outline: none; font-family: inherit; min-width: 0;
  }
  .newsletter button {
    padding: 14px 30px; background: #000; color: #fff; border: none;
    border-radius: 10px; font-weight: 700; cursor: pointer; font-family: inherit;
  }

  /* ===== FOOTER ===== */
  footer {
    background: #050818; padding: 60px 5% 20px; border-top: 1px solid rgba(0, 212, 255, 0.1);
  }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px;
  }
  .footer-col h4 { color: var(--primary); margin-bottom: 20px; font-size: 16px; }
  .footer-col p, .footer-col a {
    color: var(--muted); font-size: 14px; text-decoration: none;
    display: block; margin-bottom: 10px; transition: 0.3s;
  }
  .footer-col a:hover { color: var(--primary); padding-left: 5px; }
  .socials { display: flex; gap: 12px; margin-top: 15px; }
  .socials a {
    width: 38px; height: 38px; background: var(--dark-2); border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: var(--primary); font-size: 18px; transition: 0.3s;
  }
  .socials a:hover { background: var(--primary); color: #000; padding-left: 0; }
  .copyright {
    text-align: center; padding-top: 20px; border-top: 1px solid rgba(0, 212, 255, 0.1);
    color: var(--muted); font-size: 13px;
  }

  /* ===== MODAL ===== */
  .modal {
    display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.8);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    justify-content: center; align-items: center; z-index: 2000; padding: 20px;
  }
  .modal.active { display: flex; }
  .modal-content {
    background: var(--dark-2); padding: 30px; border-radius: 20px;
    width: 100%; max-width: 550px; max-height: 90vh; overflow-y: auto;
    border: 1px solid var(--primary); position: relative;
  }
  .modal-content h2 { color: var(--primary); margin-bottom: 20px; font-size: 24px; }
  .close-x {
    position: absolute; top: 15px; right: 20px; font-size: 24px;
    cursor: pointer; color: var(--muted); background: none; border: none;
    font-family: inherit; line-height: 1; padding: 4px 8px;
  }
  .close-x:hover { color: var(--danger); }
  .cart-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 0; border-bottom: 1px solid rgba(0, 212, 255, 0.1);
  }
  .cart-item-info { flex: 1; min-width: 0; }
  .cart-item-info strong { display: block; margin-bottom: 4px; font-size: 14px; }
  .cart-item-info span { color: var(--primary); font-weight: 600; font-size: 13px; }
  .cart-item input {
    width: 55px; padding: 6px; border-radius: 6px; border: 1px solid rgba(0, 212, 255, 0.3);
    background: var(--dark); color: var(--text); text-align: center; font-family: inherit;
  }
  .cart-total {
    text-align: right; margin: 20px 0; font-size: 18px; font-weight: 700;
    color: var(--text); line-height: 1.8;
  }
  .cart-total .grand { font-size: 24px; font-weight: 800; color: var(--primary); }
  .checkout-form input, .checkout-form textarea {
    width: 100%; padding: 12px; margin-bottom: 12px; border-radius: 10px;
    border: 1px solid rgba(0, 212, 255, 0.2); background: var(--dark);
    color: var(--text); font-family: inherit; outline: none; font-size: 14px;
  }
  .checkout-form input:focus, .checkout-form textarea:focus { border-color: var(--primary); }
  .empty-cart { text-align: center; padding: 40px 20px; color: var(--muted); }
  .order-summary {
    margin-bottom: 20px; padding: 15px; background: var(--dark);
    border-radius: 12px; font-size: 14px;
  }
  .order-summary .row { display: flex; justify-content: space-between; gap: 12px; padding: 3px 0; }
  .order-summary .row span:first-child { color: var(--muted); }
  .order-summary hr { border: none; border-top: 1px solid rgba(0, 212, 255, 0.15); margin: 10px 0; }
  .order-summary .grand { font-weight: 800; color: var(--primary); font-size: 16px; }
  .pay-options { margin-bottom: 15px; color: var(--muted); font-size: 14px; }
  .pay-options strong { color: var(--text); display: block; margin-bottom: 8px; }
  .pay-options label { display: block; margin-bottom: 6px; cursor: pointer; }
  .pay-options input { width: auto; margin-right: 8px; }
  .confirm-box { text-align: center; }
  .confirm-box .big-id {
    font-size: 22px; font-weight: 800; color: var(--primary);
    background: var(--dark); padding: 14px; border-radius: 12px;
    margin: 15px 0; letter-spacing: 1px; word-break: break-all;
  }
  .confirm-box p { color: var(--muted); font-size: 14px; margin-bottom: 10px; }
  .confirm-box .pay-box {
    background: var(--dark); padding: 12px; border-radius: 10px;
    margin: 10px 0; color: var(--text); font-weight: 600;
  }

  /* ===== TOAST ===== */
  @keyframes slideUp {
    from { opacity: 0; transform: translate(-50%, 20px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  .toast {
    position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
    background: linear-gradient(90deg, #00d4ff, #0077ff); color: #000;
    padding: 14px 28px; border-radius: 10px; font-weight: 700; z-index: 9999;
    box-shadow: 0 10px 30px rgba(0,212,255,0.5);
    animation: slideUp 0.3s ease; max-width: 90vw; text-align: center;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .hero h1 { font-size: 40px; }
    .about-content, .contact-grid { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    nav {
      display: none; position: absolute; top: calc(100% + 8px); right: 5%; left: 5%;
      background: var(--dark-2); flex-direction: column; gap: 0;
      padding: 20px; border-radius: 12px; border: 1px solid var(--primary);
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }
    nav.active { display: flex; }
    nav a { padding: 12px 0; border-bottom: 1px solid rgba(0,212,255,0.1); }
    .menu-btn { display: block; }
    .section-title h2 { font-size: 30px; }
    .newsletter form { flex-direction: column; }
  }
  @media (max-width: 500px) {
    .hero h1 { font-size: 30px; }
    .hero p { font-size: 15px; }
    .footer-grid { grid-template-columns: 1fr; }
    .btn { padding: 12px 24px; }
    section { padding: 50px 5%; }
    .products-grid { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 15px; }
    .product-card img { height: 150px; }
    .product-card h3 { font-size: 14px; min-height: 40px; }
    .product-card .price { font-size: 18px; }
  }
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">🚚 Free Delivery on Orders Above Rs. 1500 | 💰 Cash on Delivery Available</div>

<!-- HEADER -->
<header>
  <div class="logo">⚡ <span>Zyron</span> Mobile</div>
  <nav id="nav">
    <a href="#home">Home</a>
    <a href="#products">Products</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
